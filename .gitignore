# ── Secrets & configuration ─────────────────────────────────────────────
# NEVER commit real configuration or secrets. Only `.env.example` (which
# contains names but no real values) belongs in the repository.
.env
.env.local
.env.*.local
*.pem
*.key
secrets/

# ── Dependencies ────────────────────────────────────────────────────────
node_modules/
.pnp/
.pnp.js

# ── Build output ────────────────────────────────────────────────────────
.next/
out/
dist/
build/

# ── Logs ────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Prisma local artifacts ──────────────────────────────────────────────
# Generated client; regenerated from schema.prisma. Not committed.
app/node_modules/.prisma/

# ── Operating system / editor cruft ─────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/

# ── Local databases / temp ──────────────────────────────────────────────
*.sqlite
*.sqlite3
tmp/
.cache/
