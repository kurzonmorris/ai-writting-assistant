# ============================================================================
#  EXAMPLE ENVIRONMENT CONFIGURATION
# ============================================================================
#  This file documents EVERY configuration value the application needs.
#  It contains NAMES and EXPLANATIONS only — never real secrets.
#
#  To run the app locally:
#    1. Copy this file to ".env"          (cp .env.example .env)
#    2. Fill in real values in ".env"
#    3. ".env" is git-ignored and must NEVER be committed.
#
#  Why this matters: secrets in a repository are a top cause of breaches.
#  See ../docs/05-security-and-privacy.md.
# ============================================================================


# ── Database ────────────────────────────────────────────────────────────
# Connection string for PostgreSQL. Format:
#   postgresql://USER:PASSWORD@HOST:PORT/DATABASE
# Locally this points at the Postgres container (see planned docker setup).
DATABASE_URL="postgresql://user:password@localhost:5432/ai_writing_assistant"


# ── Background job queue (Redis) ────────────────────────────────────────
# Redis backs the job queue that runs slow AI extraction in the background.
REDIS_URL="redis://localhost:6379"


# ── Authentication (Auth.js) ────────────────────────────────────────────
# A long random string used to sign session cookies. Generate a fresh one;
# never reuse across environments.
AUTH_SECRET="change-me-to-a-long-random-string"

# The base URL the app runs at (used by auth callbacks).
AUTH_URL="http://localhost:3000"

# Google OAuth credentials — used BOTH for "Sign in with Google" AND for
# connecting Google Drive. Created in the Google Cloud Console.
GOOGLE_CLIENT_ID="your-google-oauth-client-id"
GOOGLE_CLIENT_SECRET="your-google-oauth-client-secret"


# ── Encryption of stored tokens ─────────────────────────────────────────
# Key used to encrypt cloud-storage tokens AT REST in the database
# (see docs 04 & 05). Must be a strong, randomly generated key. If this
# leaks, rotate it and re-encrypt. NEVER store it in the database or code.
TOKEN_ENCRYPTION_KEY="change-me-to-a-32-byte-random-key"


# ── AI providers ────────────────────────────────────────────────────────
# DECISION (doc 00, Q1): writers BRING THEIR OWN KEY. Each writer's AI API key
# is entered in the app and stored encrypted at rest (see the ProviderCredential
# table). So the app does NOT need a production AI key of its own.
#
# The key below is OPTIONAL and for LOCAL DEVELOPMENT ONLY — a convenience so a
# developer can test extraction without going through the writer key-entry flow.
# Leave it blank in production.
DEV_ANTHROPIC_API_KEY=""
# The default Claude model offered to writers (kept as a setting, not hard-coded).
ANTHROPIC_MODEL="claude-latest-model-id"

# Optional second provider (OpenAI / ChatGPT), if/when enabled.
# DEV_OPENAI_API_KEY=""
# OPENAI_MODEL="gpt-model-id"


# ── Application settings ────────────────────────────────────────────────
# Node environment: "development" locally, "production" when deployed.
NODE_ENV="development"
